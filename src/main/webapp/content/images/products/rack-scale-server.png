                                                                    if (_href && _href.indexOf('.xfusion.com/static/') < 0) {
                                                                        _href = _href.replace('.xfusion.com/', '.xfusion.com/static/');
                                                                        $(val).attr('href', _href);
                                                                    }
                                                                }
                                                                )
                                                            }
                                                        }
                                                    })
                                                }
                                                )(jQuery);
                                            </script>
