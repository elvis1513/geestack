                                                        function changeTheFooterHref(items) {
                                                            let cur_domain = window.location.hostname;
                                                            if (cur_domain == 'www.xfusion.com' || cur_domain == 'www.xfusion.com') {
                                                                jQuery.each(items, (ind, val) => {
